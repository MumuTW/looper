.ralph/
.task/
# Agent tooling checks out git worktrees here. Left untracked, they make every
# local build probe dirty (tools/go-build-flags).
.worktrees/
.DS_Store
node_modules/
dist/
internal/dashboard/assets/**
!internal/dashboard/assets/.gitkeep
*.test
# Bare `go build` output for each cmd/ entrypoint. This list can only ever cover
# names we thought of; scripts/check-tracked-binaries.sh is what actually stops
# an artifact from being committed.
/looper
/looperd
/loopernet
specs/change/active
task.md
e2e/.env*
!e2e/.env.example
# Filled HITL / deploy env files hold secrets — never commit; only the template.
deploy/**/*.env
!deploy/**/*.env.example
*.env.local
# Built onboarding bundles may contain the shared secrets — never commit.
looper-hitl-onboarding*.zip
.slim/deepwork/
