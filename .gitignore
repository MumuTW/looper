.ralph/
.task/
# Agent tooling checks out git worktrees here. Left untracked, they make every
# local build probe dirty (tools/go-build-flags).
.worktrees/
.DS_Store
node_modules/
dist/
internal/dashboard/assets/**
!internal/dashboard/assets/.gitkeep
*.test
# Bare executables `go build` drops at the repo root (issue #236): one of
# these was committed once; never again. Build output belongs in dist/.
/looper
/looperd
/loopernet
/fake-agent
/fake-gh
/fake-osascript
specs/change/active
task.md
e2e/.env*
!e2e/.env.example
# Filled HITL / deploy env files hold secrets — never commit; only the template.
deploy/**/*.env
!deploy/**/*.env.example
*.env.local
# Built onboarding bundles may contain the shared secrets — never commit.
looper-hitl-onboarding*.zip
.slim/deepwork/

# Devin CLI local project config: machine-specific absolute paths, and it
# carries the HERMES_HOME of whoever registered it. Register per clone with
# scripts/hermes-profile.sh --bootstrap's printed command instead.
.devin/
